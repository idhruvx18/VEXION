# ─────────────────────────────────────────────────────────────
#  VEXION — Environment Configuration Template
#  Copy this file to .env and fill in YOUR values.
#  NEVER commit .env to Git — it is in .gitignore.
#
#  ⚠️  If you previously pasted API keys in chat or a public
#  repository, revoke/rotate those keys immediately and use
#  fresh keys here.
# ─────────────────────────────────────────────────────────────

# ── Google Gemini (cloud AI — optional) ──────────────────────
GEMINI_API_KEY=
# Recommended: gemini-1.5-flash  or  gemini-1.5-pro
# Check https://ai.google.dev/models for available model names.
GEMINI_MODEL=

# ── ElevenLabs (voice output — optional) ─────────────────────
ELEVENLABS_API_KEY=
# Find your Voice ID at https://elevenlabs.io/app/voice-lab
# Do NOT guess or invent a Voice ID — leave blank until confirmed.
ELEVENLABS_VOICE_ID=

# ── Ollama (local AI — recommended) ──────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
# Run `ollama list` to see installed models before setting this.
OLLAMA_MODEL=qwen2.5:3b

# ── VEXION behaviour ─────────────────────────────────────────
# VEXION_DATA_DIR=   # override default ~/VEXION_data
# VEXION_LOG_LEVEL=INFO
